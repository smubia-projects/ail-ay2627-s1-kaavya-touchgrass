# TouchGrass API (Cloud Run). Copy to .env for local development; never commit real values.
# On Cloud Run the whole file is uploaded as the DOTENV repo secret and rendered by deploy.yml.

# Cloud Run injects PORT (8080). Locally the API defaults to 8080 as well.
# PORT=8080

# Comma-separated browser origins allowed by CORS (no trailing slash, no wildcard).
# Production: https://ail-ay2627-s1-kaavya-touchgrass.vercel.app
CORS_ORIGINS=http://localhost:5173

# OpenRouter (screenshot vision extraction + activity suggestions). Required for the AI features.
API_KEY=
# Must be vision-capable and support response_format json_object. Default: openai/gpt-4o-mini
MODEL_NAME=openai/gpt-4o-mini

# Shared AI Lodge rate limiter (Upstash Redis). Leave blank locally to disable limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallback limits per IP per window, used until the central control sheet overrides them.
RATE_LIMIT_VISION_MAX=5
RATE_LIMIT_ACTIVITIES_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000

# Deployed API URL (for reference; set as VITE_API_BASE on Vercel):
# https://ail-ay2627-s1-kaavya-touchgrass-464725632804.asia-southeast3.run.app
